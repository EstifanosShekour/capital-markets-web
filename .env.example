# --- Database (Neon Postgres — create free at neon.tech, paste the connection string) ---
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# --- Auth (generate a secret: run `openssl rand -base64 32` or any 32+ char random string) ---
AUTH_SECRET="replace-with-a-long-random-string"

# --- Market data (free key at financialmodelingprep.com) ---
FMP_API_KEY="your-fmp-key"

# --- Anthropic (only needed for the 10-Q analysis slice, added later) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- SEC EDGAR (required for 10-Q analysis; use your real name + email) ---
SEC_USER_AGENT="Your Name your.email@example.com"
